generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id           String               @id @default(uuid())
  tenantId     String               @default("default")
  code         String
  name         String
  color        String?
  size         String?
  colorsJson   String               @default("[]")
  sizesJson    String               @default("[]")
  status       String               @default("developing")
  isSynced     Boolean              @default(false)
  image        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  thumbnail    String?
  customerName String?
  customFields ProductCustomField[]
  samples      SampleVersion[]
  yarnUsages   YarnUsage[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model YarnUsage {
  id            String  @id @default(uuid())
  color         String
  materialName  String
  specification String?
  weight        String?
  productId     String
  materialColor String?
  unit          String?
  materialType  String?
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductCustomField {
  id        String  @id @default(uuid())
  label     String
  value     String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model SampleVersion {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  productId String
  logs      Log[]
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stages    Stage[]

  @@index([productId])
}

model Stage {
  id          String        @id @default(uuid())
  name        String
  status      String        @default("pending")
  order       Int           @default(0)
  updatedAt   DateTime      @updatedAt
  sampleId    String
  attachments Attachment[]
  sample      SampleVersion @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  fields      StageField[]

  @@index([sampleId])
}

model StageField {
  id      String @id @default(uuid())
  label   String
  value   String
  type    String @default("text")
  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId])
}

model Attachment {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  fileType  String?
  createdAt DateTime @default(now())
  stageId   String
  stage     Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId])
}

model StageTemplate {
  id        String               @id @default(uuid())
  tenantId  String               @default("default")
  name      String
  order     Int                  @default(0)
  createdAt DateTime             @default(now())
  fields    StageTemplateField[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
}

model StageTemplateField {
  id         String        @id @default(uuid())
  templateId String
  label      String
  required   Boolean       @default(false)
  order      Int           @default(0)
  template   StageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model Log {
  id       String        @id @default(uuid())
  user     String
  action   String
  detail   String
  time     DateTime      @default(now())
  sampleId String
  sample   SampleVersion @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@index([sampleId])
}
